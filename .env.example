# CampusConnect Environment Configuration
# Copy to .env for local development. Never commit real production secrets.
ENV=development
DEBUG=true
SECRET_KEY=dev-only-change-me-32-chars-minimum-secret
DATABASE_URL=sqlite:///./data/campusconnect.db
SESSION_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://127.0.0.1:8000
SUPPORT_EMAIL=support@campusconnect.local
